{
  "expo": {
    "name": "Mang Takyu SmartStaff",
    "slug": "mang-takyu-smartstaff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A1128"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1128"
      }
    },
    "web": {
      "bundler": "metro" } ,
      "plugins": [
  [
    "expo-image-picker",
    {
      "photosPermission": "Allow Mang Takyu SmartStaff to access your photos for attendance proof.",
      "cameraPermission": "Allow Mang Takyu SmartStaff to use your camera for attendance proof."
    }
  ]
]
    }
  }

